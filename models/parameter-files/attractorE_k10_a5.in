# attractorE benchmark "k10_a5" (arXiv:2510.18656, see notes/inflation_models.tex Table 2)
# Generated with: python3 notes/attractor_ics.py E --alpha 5 --k 10 --kappa 1 --nstar 60
# E-model alphaAtt=5.0 k=10 kappa=1.0 N*=60.0
# slow roll at x_*=12.1606: ns=0.9660 r=0.01519;  x_end=3.0276, H_end=5.3182e+12 GeV
# Program units: x = phi/MPl, omegaStar = oscillation frequency at the initial amplitude,
# alpha = 3(k-2)/(k+2). Lattice settings are a starting point and should be tuned.

#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.02
kIR = 0.05

#Times
tOutputFreq = 0.5
tOutputInfreq = 5
tOutputRareFreq = 20
tMax = 200

#IC
kCutOff = 2
initial_amplitudes = 7.372206e+18 0 # GeV
initial_momenta = -1.831397e+31 0 # GeV^2

#Model Parameters
lambda = 7.087468e-10
alphaAtt = 5.0
k = 10
kappa = 1.0
g = 0 # inflaton-daughter coupling (1/2) g^2 phi^2 chi^2; 0 = inflaton self-resonance only

#GWs
withGWs = false
GWprojectorType = 1
