# attractorT benchmark "k6_a1" (arXiv:2510.18656, see notes/inflation_models.tex Table 2)
# Generated with: python3 notes/attractor_ics.py T --alpha 1 --k 6 --kappa 1 --nstar 58
# T-model alphaAtt=1.0 k=6 kappa=1.0 N*=58.0
# slow roll at x_*=7.5051: ns=0.9646 r=0.00365;  x_end=1.9835, H_end=5.5788e+12 GeV
# Program units: x = phi/MPl, omegaStar = oscillation frequency at the initial amplitude,
# alpha = 3(k-2)/(k+2). Lattice settings are a starting point and should be tuned.

#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.02
kIR = 0.05

#Times
tOutputFreq = 0.5
tOutputInfreq = 5
tOutputRareFreq = 20
tMax = 200

#IC
kCutOff = 2
initial_amplitudes = 4.829918e+18 0 # GeV
initial_momenta = -1.921118e+31 0 # GeV^2

#Model Parameters
lambda = 1.554806e-10
alphaAtt = 1.0
k = 6
kappa = 1.0
g = 0 # inflaton-daughter coupling (1/2) g^2 phi^2 chi^2; 0 = inflaton self-resonance only

#GWs
withGWs = false
GWprojectorType = 1
