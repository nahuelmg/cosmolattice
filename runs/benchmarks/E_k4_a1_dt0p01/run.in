# attractorE benchmark "k4_a1" (arXiv:2510.18656, see notes/inflation_models.tex Table 2)
# Generated with: python3 notes/attractor_ics.py E --alpha 1 --k 4 --kappa 1 --nstar 55.7
# E-model alphaAtt=1.0 k=4 kappa=1.0 N*=55.7
# slow roll at x_*=6.1496: ns=0.9639 r=0.00376;  x_end=1.1010, H_end=6.6367e+12 GeV
# Program units: x = phi/MPl, omegaStar = oscillation frequency at the initial amplitude,
# alpha = 3(k-2)/(k+2). Lattice settings are a starting point and should be tuned.

#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt=0.01 # override
kIR=0.5 # override

#Times
tOutputFreq = 0.5
tOutputInfreq=10 # override
tOutputRareFreq = 20
tMax=300 # override

#IC
kCutOff=20 # override
initial_amplitudes = 2.680893e+18 0 # GeV
initial_momenta = -2.285415e+31 0 # GeV^2

#Model Parameters
lambda = 1.601940e-10
alphaAtt = 1.0
k = 4
kappa = 1.0
g=2.923e-03 # override

#GWs
withGWs=true # override
GWprojectorType = 1
