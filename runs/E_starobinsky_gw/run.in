# attractorE benchmark "k2_a1_starobinsky" (arXiv:2510.18656, see notes/inflation_models.tex Table 2)
# Generated with: python3 notes/attractor_ics.py E --alpha 1 --k 2 --kappa 1 --nstar 50
# E-model alphaAtt=1.0 k=2 kappa=1.0 N*=50.0
# slow roll at x_*=5.2096: ns=0.9604 r=0.00443;  x_end=0.6146, H_end=8.0922e+12 GeV
# Program units: x = phi/MPl, omegaStar = oscillation frequency at the initial amplitude,
# alpha = 3(k-2)/(k+2). Lattice settings are a starting point and should be tuned.

#Output
outputfile = ./
print_headers = true
overwriteFiles = false

#Evolution
expansion = true
evolver = VV2

#Lattice
N = 64
dt = 0.01
kIR = 0.5

#Times
tOutputFreq = 0.5
tOutputInfreq = 10
tOutputRareFreq = 20
tMax = 300

#IC
kCutOff = 20
initial_amplitudes = 1.496658e+18 0 # GeV
initial_momenta = -2.786625e+31 0 # GeV^2

#Model Parameters
lambda = 1.891475e-10
alphaAtt = 1.0
k = 2
kappa = 1.0
g = 4.5e-3 # q0 = g^2 Phi_i^2/(4 m^2) ~ 1e4: broad parametric resonance

#GWs
withGWs = true
GWprojectorType = 1
